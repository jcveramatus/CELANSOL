# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local a git.

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# Sitio
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# El WhatsApp de la tienda se configura en el panel: Tienda online → Preferencias.

# Meta Conversions API (el ID del Pixel se configura en Tienda online → Preferencias)
META_CAPI_ACCESS_TOKEN=

# Dropi (se usan en la tarea 8). DROPI_MODE=manual hasta tener acceso a la API.
DROPI_MODE=manual
DROPI_API_URL=
DROPI_API_TOKEN=
